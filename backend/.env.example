# =========================================================================================
# DỰ ÁN: HỆ THỐNG QUẢN LÝ VÀ HỌC TRỰC TUYẾN TỰ ĐỘNG HÓA CHO TRUNG TÂM ĐÀO TẠO LÁI XE (LMS)
# TẬP TIN: .env.example (MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG)
# =========================================================================================

# --- 1. CẤU HÌNH ỨNG DỤNG ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- 2. CẤU HÌNH CƠ SỞ DỮ LIỆU MICROSOFT SQL SERVER ---
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=SQL2019
DB_NAME=QL_DaoTaoLaiXe
DB_USERNAME=sa
DB_PASSWORD=your_sa_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# --- 3. BẢO MẬT & XÁC THỰC (JWT AUTHENTICATION) ---
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# --- 4. TỰ ĐỘNG HÓA & FILE UPLOAD ---
UPLOAD_DEST=./uploads
UPLOAD_MAX_FILE_SIZE=20971520

# --- 5. BẢO MẬT MẠNG & CORS ---
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
